# WattWise AI — environment template
# Copy to .env and fill in real values:  Copy-Item .env.example .env
# NEVER commit the real .env (it is gitignored).

# ---- Azure IoT Hub ----
IOT_HUB_CONNECTION_STRING=HostName=<hub>.azure-devices.net;SharedAccessKeyName=...;SharedAccessKey=...
IOT_HUB_DEVICE_CONNECTION_STRING=HostName=<hub>.azure-devices.net;DeviceId=...;SharedAccessKey=...

# ---- Azure Storage (Blob) ----
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
AZURE_BLOB_CONTAINER=wattwise-artifacts

# ---- ClickHouse (local docker defaults) ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=wattwise
CLICKHOUSE_USER=wattwise
CLICKHOUSE_PASSWORD=wattwise_dev

# ---- AI inference ----
GEMINI_API_KEY=<from https://aistudio.google.com>
HUGGINGFACE_API_TOKEN=<from https://huggingface.co/settings/tokens>
OLLAMA_HOST=http://localhost:11434

# ---- Alerting ----
ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=...
ACS_SENDER_EMAIL=DoNotReply@<your-domain>.azurecomm.net
ALERT_RECIPIENT_EMAIL=you@psiog.com
TWILIO_ACCOUNT_SID=<from https://www.twilio.com>
TWILIO_AUTH_TOKEN=<from https://www.twilio.com>
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+91XXXXXXXXXX

# ---- MLflow ----
MLFLOW_TRACKING_URI=file:./mlruns

# ---- Peak demand config ----
PEAK_DEMAND_THRESHOLD_KW=500
PEAK_WARN_RATIO=0.90
